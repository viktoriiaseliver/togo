// Общие настройки проекта Того.
// Здесь одно место, где меняются идентификатор, команда и версия.

// Идентификатор приложения. Расширения наследуют его как префикс.
APP_BUNDLE_ID = app.togo.diary

// Team ID из App Store Connect. Пусто — сборка только в симуляторе.
DEVELOPMENT_TEAM =

// Версия для App Store и номер сборки.
MARKETING_VERSION = 1.0.0
BUILD_NUMBER = 1

// App Group — общее хранилище приложения, виджетов и Live Activity.
APP_GROUP_ID = group.app.togo.diary

// Схема ссылок для приглашений в семью: togo://join/...
URL_SCHEME = togo

// Какой файл прав подписи брать. Пусто — полный набор: App Groups и iCloud,
// как нужно для App Store. Для установки на свой телефон с бесплатной
// командой разработчика их выдать нельзя, поэтому:
//
//   make device TEAM=XXXXXXXXXX      # ставит с ENTITLEMENTS_VARIANT=-Personal
//
ENTITLEMENTS_VARIANT =
