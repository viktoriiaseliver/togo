<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(APP_BUNDLE_ID)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!--
	  Хранилища «ключ-значение» в iCloud приложение не использует:
	  настройки телефона остаются на телефоне, а дневник синхронизируется
	  через CloudKit. Заявленная и неиспользуемая возможность — лишний
	  повод для вопросов на ревью и лишняя строка в профиле подписи.
	-->

	<!--
	  Push нужен самому CloudKit: без него зеркалирование узнаёт
	  об изменениях с других устройств только при запуске приложения,
	  и «синхронизация» превращается в «иногда подтягивается».
	  Своих уведомлений через сервер приложение не шлёт.
	-->
	<key>aps-environment</key>
	<string>development</string>

	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
