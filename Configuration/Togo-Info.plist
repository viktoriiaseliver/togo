<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleDisplayName</key>
	<string>Того</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  Пока только русский. Ключи для английского и французского собраны
	  (docs/TEXTS.md), но перевода ещё нет: заявить язык, которого в
	  интерфейсе нет, — значит показать в App Store поддержку, которой
	  не существует, и получить единицу в отзыве.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(URL_SCHEME)</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  Брендовый шрифт. Он используется только для вордмарка и крупных
	  чисел — секундомера, отсчёта натощак, веса; весь интерфейс
	  по-прежнему системный SF Pro. Onest под лицензией SIL OFL 1.1,
	  вкладывать в приложение её прямо разрешает.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>Onest-ExtraBold.ttf</string>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Paper</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>

	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<!--
	  Единственный фоновый режим — приём тихих уведомлений CloudKit.
	  Он не для наших пушей: своих уведомлений через сервер приложение
	  не шлёт. Без него зеркалирование узнаёт об изменениях с других
	  устройств только при запуске, и обмен превращается в «иногда
	  подтягивается».
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!--
	  Фоновый режим `processing` отсюда убран. `BGTaskScheduler`
	  в приложении не вызывается ни разу: утренний бриф — это обычное
	  локальное уведомление по расписанию, фон ему не нужен.
	  А объявленный и неиспользуемый фоновый режим — это Guideline 2.5.4
	  и отклонение на ревью.
	-->

	<!--
	  Строк-разрешений здесь больше нет, и это не забывчивость.
	  Снимки документов выбираются системным `PhotosPicker`: он работает
	  в отдельном процессе, отдаёт приложению ровно один выбранный кадр
	  и доступа к библиотеке не требует вовсе.

	  Камеры, Face ID и отслеживания в приложении нет. Объявлять строки
	  под них — значит обещать ревьюеру функции, которых не существует,
	  и получить вопрос, на который нечего ответить.
	-->
</dict>
</plist>
