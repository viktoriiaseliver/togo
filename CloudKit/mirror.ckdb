    CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
    CD_id                         STRING QUERYABLE SEARCHABLE SORTABLE,
    CD_intervalDays               INT64 QUERYABLE SORTABLE,
    CD_kindRaw                    STRING QUERYABLE SEARCHABLE SORTABLE,
    CD_lastDone                   TIMESTAMP QUERYABLE SORTABLE,
    CD_remindDaysBefore           INT64 QUERYABLE SORTABLE,
    CD_scheduledDate              TIMESTAMP QUERYABLE SORTABLE,
    CD_seasonEndMonth             INT64 QUERYABLE SORTABLE,
    CD_seasonStartMonth           INT64 QUERYABLE SORTABLE,
    CD_snoozeCount                INT64 QUERYABLE SORTABLE,
    CD_streak                     INT64 QUERYABLE SORTABLE,
    CD_title                      STRING QUERYABLE SEARCHABLE SORTABLE,
    "___createTime" TIMESTAMP,
