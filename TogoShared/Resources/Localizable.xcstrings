        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рөл бұны жасауға рұқсат бермейді, бірақ түйме қолжетімді болды. Түртуден кейін бас тартқаннан гөрі оны мүлде көрсетпеу дұрыс."
          }
        },
        "ru" : {
