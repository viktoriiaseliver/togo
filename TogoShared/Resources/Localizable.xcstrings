        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кем дегенде жазбасы бар %@ қажет — әзірше %@. Шығуларды белгілеуді жалғастыр."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно хотя бы %@ с записями — пока их %@. Просто продолжай отмечать выходы."
