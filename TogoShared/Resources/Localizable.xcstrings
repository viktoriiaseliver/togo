    "%@ — на письмо отвечает человек, обычно в течение двух рабочих дней." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ — a person answers your message, usually within two working days."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — un humain répond aux messages, en général sous deux jours ouvrés."
          }
        },
