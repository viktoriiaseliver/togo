    "ровно через %@" : {
      "comment" : "scheduleSubtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "in exactly %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dans exactement %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ровно через %@"
          }
        },
        "uk" : {
          "stringUnit" : {
