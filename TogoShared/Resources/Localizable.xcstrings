    "Наблюдать дальше · напомнить через час" : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keep watching · remind me in an hour"
          }
        },
        "fr" : {
