    "Собака" : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dog"
          }
        },
        "fr" : {
          "stringUnit" : {
