        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce ne sont pas tes réglages : l'app n'a pas le droit d'interroger l'App Store. Écris-nous."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дело не в твоих настройках: приложению не разрешено спрашивать App Store. Напиши нам."
