    "Наблюдатель читает всё и не пишет, помощник пишет бытовое и не видит медицинского." : {
      "comment" : "items",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "An observer reads everything and writes nothing; a helper notes everyday things and sees nothing medical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'observateur lit tout et n'écrit rien, l'assistant note le quotidien et ne voit pas le médical."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Бақылаушы бәрін оқиды және жазбайды, көмекші тұрмыстық нәрсені жазады және медициналық мәліметті көрмейді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наблюдатель читает всё и не пишет, помощник пишет бытовое и не видит медицинского."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спостерігач читає все і не пише, помічник пише побутове і не бачить медичного."
          }
        }
      }
    },
