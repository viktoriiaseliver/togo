    "Визит уйдёт из истории и из отчёта врачу. Диагнозы и назначения останутся." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визит уйдёт из истории и из отчёта врачу. Диагнозы и назначения останутся."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The visit will leave the history and the vet report. Diagnoses and prescriptions stay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La visite quittera l'historique et le compte rendu véto. Les diagnostics et les ordonnances restent."
