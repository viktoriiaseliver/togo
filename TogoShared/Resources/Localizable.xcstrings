    "%@ сеансов подряд без единой записи — открывали не записать, а посмотреть. Стоит понять, что именно." : {
      "comment" : "idle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sessions in a row without a single entry — the app was opened to look, not to note. Worth finding out what for."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sessions d'affilée sans une seule entrée — on ouvrait pour regarder, pas pour noter. Reste à comprendre quoi."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Қатарынан %@ сеанс бір де жазбасыз — жазу үшін емес, қарау үшін ашқан. Нақты нені екенін түсіну керек."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сеансов подряд без единой записи — открывали не записать, а посмотреть. Стоит понять, что именно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ сеансів поспіль без жодного запису — відкривали не записати, а подивитися. Варто зрозуміти, що саме."
          }
        }
      }
    },
