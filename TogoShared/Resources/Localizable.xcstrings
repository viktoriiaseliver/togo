    "Промежутки ровные и днём, и ночью — собаке так спокойнее всего." : {
      "comment" : "plan",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Even gaps by day and by night — that's what settles a dog best."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les intervalles sont réguliers, le jour comme la nuit — c'est ce qui rassure le plus le chien."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Аралықтар күндіз де, түнде де біркелкі — итке осылай ең тыныш."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промежутки ровные и днём, и ночью — собаке так спокойнее всего."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Проміжки рівні і вдень, і вночі — собаці так найспокійніше."
          }
        }
      }
    },
