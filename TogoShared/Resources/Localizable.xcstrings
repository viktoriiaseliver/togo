    "%@. Из матрицы переноса он тоже уйдёт. Занятия, которые уже прошли, останутся." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. It will leave the generalization matrix too. Sessions already done will stay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Elle disparaîtra aussi de la matrice de transfert. Les séances déjà passées resteront."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Из матрицы переноса он тоже уйдёт. Занятия, которые уже прошли, останутся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. З матриці перенесення він теж піде. Заняття, які вже пройшли, залишаться."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Тасымалдау матрицасынан да кетеді. Өткен сабақтар қалады."
          }
        }
      }
    },
