    "Номер нужен в аптеке — он же стоит первым в списке." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номер нужен в аптеке — он же стоит первым в списке."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The pharmacy needs the number — it's also what comes first in the list."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La pharmacie a besoin du numéro — c'est aussi lui qui vient en premier dans la liste."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Номер потрібен в аптеці — він же стоїть першим у списку."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нөмір дәріханада қажет — ол тізімде де бірінші тұрады."
          }
        }
      }
    },
    "Номер связывает строки одного бланка между собой — в списке они встанут вместе." : {
      "comment" : "Шаги",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номер связывает строки одного бланка между собой — в списке они встанут вместе."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The number ties the lines of one form together — they'll stand together in the list."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le numéro relie entre elles les lignes d'une même fiche — elles apparaîtront groupées dans la liste."
