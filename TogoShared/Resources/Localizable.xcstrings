      }
    },
    "Мы не собираем идентификаторы рекламы, не используем трекеры и не подключаем сторонние SDK аналитики." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We don't collect advertising identifiers, don't use trackers and don't include third-party analytics SDKs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne collectons aucun identifiant publicitaire, n'utilisons pas de traceurs et n'intégrons aucun SDK d'analyse tiers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
