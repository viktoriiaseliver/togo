    "Где вкладка «Здоровье»?" : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Where is the “Health” tab?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où est l'onglet « Santé » ?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Денсаулық» беті қайда?"
          }
        },
        "ru" : {
