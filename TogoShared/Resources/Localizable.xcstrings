    "Дневник ездит через твой личный iCloud, а не через чужой сервер. Аккаунт в Togo не нужен." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дневник ездит через твой личный iCloud, а не через чужой сервер. Аккаунт в Togo не нужен."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The diary travels through your own iCloud, not someone else's server. No Togo account needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le journal passe par ton iCloud personnel, pas par le serveur d'un tiers. Aucun compte Togo n'est nécessaire."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоденник їздить через твій особистий iCloud, а не через чужий сервер. Акаунт у Togo не потрібен."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Күнделік бөтен сервер арқылы емес, сенің жеке iCloud-ың арқылы жүреді. Togo-да аккаунт қажет емес."
          }
        }
      }
    },
