    "Срыв — это порог, а не проступок" : {
      "comment" : "reactionCard",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A reaction is a threshold, not misbehavior"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une réaction est un seuil, pas une faute"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ашулану — шек, тәртіп бұзу емес"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срыв — это порог, а не проступок"
          }
        },
