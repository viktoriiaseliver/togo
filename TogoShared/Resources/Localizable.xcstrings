    "чтобы не переводить собаку на другой корм в спешке" : {
      "comment" : "restockCard",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "so you don't have to switch her food in a hurry"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pour ne pas changer d'aliment dans la précipitation"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "чтобы не переводить собаку на другой корм в спешке"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "щоб не переводити собаку на інший корм поспіхом"
