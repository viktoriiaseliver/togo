    "%@, ещё раз. Одно удачное занятие — не навык; нужно второе, чтобы идти дальше." : {
      "comment" : "nextStepText",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, once more. One good session isn't a skill; you need a second one to move on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, encore une fois. Une séance réussie ne fait pas une compétence ; il en faut une deuxième pour aller plus loin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ещё раз. Одно удачное занятие — не навык; нужно второе, чтобы идти дальше."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, ще раз. Одне вдале заняття — не навичка; потрібне друге, щоб іти далі."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@, қайтадан. Бір сәтті сабақ — дағды емес; әрі қарай жүру үшін екіншісі қажет."
          }
        }
      }
    },
