          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пауза"
          }
        }
      }
    },
    "Пауза оставляет схему в истории и в отчёте врачу — в отличие от удаления." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pausing keeps the plan in the history and in the vet report — deleting doesn't."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pause garde le traitement dans l'historique et dans le compte rendu pour le vétérinaire — contrairement à la suppression."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза оставляет схему в истории и в отчёте врачу — в отличие от удаления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пауза залишає схему в історії і у звіті лікарю — на відміну від видалення."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кідірту жоюдан өзгеше — схеманы тарихта және дәрігерге есепте қалдырады."
          }
        }
      }
    },
    "Первое" : {
      "comment" : "count",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "First"
          }
        },
        "fr" : {
          "stringUnit" : {
