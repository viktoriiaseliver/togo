    "Вкладка «Здоровье» спрячется. %@" : {
      "comment" : "tail",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The “Health” tab will hide itself. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'onglet «Santé» se masquera. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
