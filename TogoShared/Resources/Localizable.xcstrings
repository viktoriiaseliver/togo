        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не підставляємо самі: рецепт часто заводять заднім числом, а вага відтоді змінилася. Сьогоднішня — у підказці."
          }
        }
      }
    },
