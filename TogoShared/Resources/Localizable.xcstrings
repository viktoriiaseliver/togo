    "Выше — жиже. Терракотовые столбики — дни с кровью или слизью." : {
      "comment" : "chartExplainer",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Higher means looser. Terracotta bars are days with blood or mucus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus haut, plus molles. Les barres terracotta, ce sont les jours avec du sang ou du mucus."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Жоғары — сұйығырақ. Қоңыр бағандар — қан немесе шырыш болған күндер."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выше — жиже. Терракотовые столбики — дни с кровью или слизью."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вище — рідкіше. Теракотові стовпчики — дні з кров'ю або слизом."
          }
        }
      }
    },
    "Выше — жиже. Три жидких подряд — эпизод." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Higher is looser. Three loose in a row — episode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plus haut = plus liquide. Trois liquides de suite — épisode."
