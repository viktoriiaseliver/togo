        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "While it's off, a member is only a name in the “author” field: they can mark things from this phone alone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant qu'il est désactivé, le membre n'est qu'un nom dans le champ « auteur » : il ne peut noter que depuis ce téléphone."
