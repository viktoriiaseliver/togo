    "Напоминание перестанет приходить по утрам. Записи о том, что уже сделано, останутся в истории." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The reminder will stop arriving in the mornings. Entries about what's already done stay in the history."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rappel n'arrivera plus le matin. Les entrées de ce qui a déjà été fait restent dans l'historique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминание перестанет приходить по утрам. Записи о том, что уже сделано, останутся в истории."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нагадування перестане приходити вранці. Записи про те, що вже зроблено, залишаться в історії."
          }
        },
        "kk" : {
          "stringUnit" : {
