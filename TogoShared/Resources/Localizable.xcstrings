    "Аккаунта нет, серверов у нас нет. Записи хранятся в базе приложения и в общем хранилище с виджетами." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "There's no account and we have no servers. Entries live in the app's own database and in the storage it shares with the widgets."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de serveurs chez nous. Les entrées sont stockées dans la base de l'app et dans l'espace partagé avec les widgets."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Аккаунт жоқ, бізде сервер жоқ. Жазбалар қолданба дерекқорында және виджеттермен ортақ сақтауда тұрады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунта нет, серверов у нас нет. Записи хранятся в базе приложения и в общем хранилище с виджетами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Акаунта немає, серверів у нас немає. Записи лежать у базі застосунку і в спільному сховищі з віджетами."
          }
        }
      }
    },
