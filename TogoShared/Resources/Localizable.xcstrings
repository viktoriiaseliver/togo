        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant les heures calmes, l'app ne demande pas le résultat de la sortie : elle rassemblera tout le matin en une seule carte."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тыныш сағаттарда қолданба шығудың нәтижесін сұрамайды — таңертең бір картамен жинайды."
