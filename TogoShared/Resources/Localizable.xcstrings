    "Колются на острые осколки. Не вызывай рвоту — можно поранить пищевод." : {
      "comment" : "detail",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "They splinter into sharp fragments. Don't induce vomiting — the esophagus can be injured."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils se brisent en éclats pointus. Ne fais pas vomir — l'œsophage peut être blessé."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Өткір сынықтарға бөлінеді. Құсуды шақырма — өңешті жаралауға болады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колются на острые осколки. Не вызывай рвоту — можно поранить пищевод."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Колються на гострі осколки. Не викликай блювоту — можна поранити стравохід."
          }
        }
      }
    },
