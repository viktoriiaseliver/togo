    "Приём по схеме лечения. Если препарат переименовали, здесь всё равно видно, какой именно отметили." : {
      "comment" : "origin",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A dose from the treatment plan. Even if the medication was renamed, you can still see here which one was marked."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
