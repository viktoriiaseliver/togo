    "%@ чаще просит спокойно. Дверь открывается после тишины — тишина и закрепляется." : {
      "comment" : "advice",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ asks calmly more often now. The door opens after quiet — so quiet is what gets reinforced."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande plus souvent calmement. La porte s'ouvre après le silence — c'est le silence qui se renforce."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ жиірек тыныш сұрайды. Есік үнсіздіктен кейін ашылады — үнсіздік те нығаяды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ чаще просит спокойно. Дверь открывается после тишины — тишина и закрепляется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ частіше просить спокійно. Двері відчиняються після тиші — тиша і закріплюється."
          }
        }
      }
