        }
      }
    },
    "Приглашает и убирает участников владелец. Твои отметки приходят к нему, его — к тебе." : {
      "comment" : "guestCard",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The owner invites and removes members. Your marks reach them, and theirs reach you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est le propriétaire qui invite et retire les membres. Tes entrées lui parviennent, les siennes t'arrivent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приглашает и убирает участников владелец. Твои отметки приходят к нему, его — к тебе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запрошує і прибирає учасників власник. Твої позначки приходять до нього, його — до тебе."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Қатысушыларды иесі шақырады және алып тастайды. Сенің белгілерің оған келеді, оның белгілері саған."
          }
        }
      }
    },
