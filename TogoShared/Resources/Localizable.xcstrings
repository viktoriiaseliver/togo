          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Усе рахується на телефоні. Акаунт не потрібен, серверів у нас немає. Перевстановлення щоденник переживає через iCloud або файл."
          }
        }
