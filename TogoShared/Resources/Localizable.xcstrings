    "Сведу в ту, что заведена %@, и перенесу в неё %lld записей. Ничего не удалится." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I'll merge into the one created %@ and move %lld entries into it. Nothing will be deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je fusionne vers celle créée le %@ et j'y déplace %lld entrées. Rien ne sera supprimé."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ жасалғанына біріктіріп, оған %lld жазба көшіремін. Ештеңе жойылмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Сведу в ту, что заведена %1$@, и перенесу в неё %2$lld записей. Ничего не удалится."
