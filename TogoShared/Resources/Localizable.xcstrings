      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The app isn't meant to be used on their own by children under 13. The “helper” role is designed for a child using an adult's phone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application n'est pas destinée à être utilisée seule par des enfants de moins de 13 ans. Le rôle « assistant » est prévu pour un enfant qui utilise le téléphone d'un adulte."
          }
        },
        "ru" : {
          "stringUnit" : {
