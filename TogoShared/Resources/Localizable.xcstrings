    "ровно через %@" : {
      "comment" : "scheduleSubtitle",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "in exactly %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dans exactement %@"
          }
        },
        "kk" : {
          "stringUnit" : {
