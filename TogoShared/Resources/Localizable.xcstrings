    "Резко появившийся лай или беспокойство у двери — это может быть не поведение, а дискомфорт." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Barking or restlessness at the door that started abruptly may not be behavior but discomfort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des aboiements ou une agitation à la porte apparus d'un coup : ce n'est peut-être pas du comportement, mais de l'inconfort."
