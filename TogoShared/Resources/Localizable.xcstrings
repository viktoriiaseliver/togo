    "Наблюдатель читает всё и не пишет, помощник пишет бытовое и не видит медицинского." : {
      "comment" : "items",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "An observer reads everything and writes nothing; a helper notes everyday things and sees nothing medical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'observateur lit tout et n'écrit rien, l'assistant note le quotidien et ne voit pas le médical."
