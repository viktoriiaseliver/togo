    "Кровь в стуле или рвоте. Многократная рвота. Отказ от воды." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blood in the stool or vomit. Repeated vomiting. Refusing water."
          }
        },
        "fr" : {
