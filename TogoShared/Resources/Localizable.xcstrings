    "Вышли %@ назад, и он сходил. Всё равно можно вывести — запись ляжет в дневник, и в следующий раз вердикт будет точнее." : {
      "comment" : "since",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "You went out %@ ago and she did her business. You can still take her out — the entry will go into the diary, and next time the verdict will be sharper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortie il y a %@, et il a fait ses besoins. Tu peux quand même le sortir — l'entrée ira dans le journal, et le prochain verdict sera plus précis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вышли %@ назад, и он сходил. Всё равно можно вывести — запись ляжет в дневник, и в следующий раз вердикт будет точнее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вийшли %@ тому, і він сходив. Усе одно можна вивести — запис ляже у щоденник, і наступного разу вердикт буде точніший."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ бұрын шықты және дәретке шықты. Бәрібір шығаруға болады — жазба күнделікке түседі, келесіде шешім дәлірек болады."
          }
        }
      }
    },
