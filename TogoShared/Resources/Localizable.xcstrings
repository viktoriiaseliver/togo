        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A long outing"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longue sortie"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Долгий выход"
          }
        },
        "uk" : {
