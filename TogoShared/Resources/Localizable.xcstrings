    "Меняй за раз что-то одно: новое место — верни короткую дистанцию." : {
      "comment" : "nextStepCard",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change one thing at a time: a new place means going back to a short distance."
          }
        },
        "fr" : {
          "stringUnit" : {
