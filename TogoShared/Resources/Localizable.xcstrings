    "НЕ ОТКРЫВАЛИ НИ РАЗУ" : {
      "comment" : "lines",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "NEVER OPENED"
          }
        },
        "fr" : {
