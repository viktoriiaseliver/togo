      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The Bristol scale 1–7 exists, but only in the database and in the vet report — you never have to pick it by hand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'échelle de Bristol 1–7 existe, mais seulement dans la base et dans le compte rendu pour le vétérinaire — pas besoin de la choisir à la main."
