            "state" : "needs_review",
            "value" : "Mark the dose and the app will note the time and work out +4 and +6 hours itself."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coche la prise du médicament — l'app note l'heure et calcule elle-même +4 h et +6 h."
