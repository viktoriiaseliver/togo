    "Без собаки приложению нечего считать — начни с неё." : {
      "comment" : "dogSection",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "With no dog there's nothing for the app to count — start with her."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans chien, l'app n'a rien à calculer : commence par lui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без собаки приложению нечего считать — начни с неё."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
