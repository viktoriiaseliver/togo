    "Дежурный получает напоминания, и только он. Передача дежурства — одно действие." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whoever is on duty gets the reminders, and only them. Handing the duty over takes one action."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui qui est de garde reçoit les rappels, et lui seul. Passer la garde tient en une action."
