          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "паспорт и прививки спрашивают первыми — у врача, на границе и в гостинице"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "паспорт і щеплення запитують першими — у лікаря, на кордоні і в готелі"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "төлқұжат пен екпелерді алдымен сұрайды — дәрігерде, шекарада және қонақ үйде"
          }
        }
      }
    },
    "Пауза" : {
      "comment" : "walkSheet",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
