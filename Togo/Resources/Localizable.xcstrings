    },
    "После долгих дней стул на следующий день бывал жиже — %@ из %@." : {
      "comment" : "lines",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après les longues journées, les selles du lendemain ont été plus molles — %@ sur %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После долгих дней стул на следующий день бывал жиже — %@ из %@."
          }
        }
      }
    },
    "После долгих дней она ела заметно меньше обычного — %@ из %@." : {
      "comment" : "lines",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
