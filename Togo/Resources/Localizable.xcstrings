        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если не берёт еду — заканчивай"
          }
        }
      }
    },
    "Если не помогло — переустановить. Дневник вернётся из iCloud или из сохранённого файла." : {
      "comment" : "steps",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ça ne suffit pas, réinstaller. Le journal reviendra depuis iCloud ou depuis le fichier enregistré."
