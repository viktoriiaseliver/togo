      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En moyenne %@ g par jour, soit %@ % de plus que la ration. Rien d'urgent, mais sur deux semaines ça finit en kilos en trop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В среднем %@ г в день — на %@% больше нормы. Это не срочно, но за две недели складывается в лишний вес."
          }
        }
      }
    },
