    "Приложение помогает вести записи и не является медицинским устройством. Диагнозов не ставит, дозировок не назначает." : {
      "comment" : "disclaimer",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение помогает вести записи и не является медицинским устройством. Диагнозов не ставит, дозировок не назначает."
          }
        }
      }
    },
