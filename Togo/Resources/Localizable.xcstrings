      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul tap si tout est comme d'habitude : la forme est notée tout de suite, pas besoin d'«Enregistrer». Tu peux annuler en bas de l'écran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один тап, если всё как обычно: форма записывается сразу, «Сохранить» не нужно. Отменить можно внизу экрана."
          }
        }
      }
    },
    "одним тапом, если помнишь" : {
      "comment" : "reactionCard",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
