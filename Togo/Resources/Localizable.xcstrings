      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version courte : le journal vit sur ton téléphone. Nous ne créons pas de compte, ne collectons pas d'analytique sur ce que tu notes et ne transmettons pas de données à des tiers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткая версия: дневник живёт на твоём телефоне. Мы не заводим аккаунт, не собираем аналитику о том, что ты записываешь, и не передаём данные третьим лицам."
