    "Отметок уже %@. Их можно записать — прогресс посчитается, если занятие уложилось в три минуты." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà %@ marques. Tu peux les enregistrer — le progrès comptera si la séance a tenu en trois minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
