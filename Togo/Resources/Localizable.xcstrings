      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En général autour de %@. Redouble d'attention en promenade : les mâles la sentent à un kilomètre, et ça n'a rien à voir avec l'éducation."
          }
        },
        "ru" : {
          "stringUnit" : {
