      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est coché, presque tous en ont besoin. Les dents, c'est chaque jour : la plaque durcit en 24 h. Le reste dépend du chien et se change à tout moment."
          }
        },
