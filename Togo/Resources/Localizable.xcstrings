    "ты в чужом дневнике" : {
      "comment" : "guestCard",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tu es dans le journal de quelqu'un d'autre"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ты в чужом дневнике"
