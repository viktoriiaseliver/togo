      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un intervalle régulier entre les repas compte plus que l'heure exacte : le chien s'habitue à l'écart, pas au chiffre sur l'horloge. La nuit compte comme le jour."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровный интервал между кормлениями важнее точного часа: собака привыкает к промежутку, а не к цифре на часах. Ночь считается так же, как день."
          }
        }
      }
    },
