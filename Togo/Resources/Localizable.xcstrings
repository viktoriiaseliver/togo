    "Эти три строки помогают воспроизвести проблему. Никаких записей о собаке в них нет." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces trois lignes aident à reproduire le problème. Elles ne contiennent aucune entrée sur le chien."
          }
        },
        "ru" : {
          "stringUnit" : {
