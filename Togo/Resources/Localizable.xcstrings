      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app demandera s'il faut tout remplacer ou ajouter ce qui manque. Le même fichier chargé deux fois ne crée aucun doublon — les entrées sont comparées entre elles."
          }
        },
        "ru" : {
