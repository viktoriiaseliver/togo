      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journée a été longue. Demain, elle voudra sûrement rattraper son sommeil — c'est normal, pas de quoi s'inquiéter. Mieux vaut des promenades courtes et calmes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День был долгий. Завтра ей, скорее всего, захочется отсыпаться — это нормально и не повод для тревоги. Прогулки лучше короткие и спокойные."
          }
        }
      }
    },
