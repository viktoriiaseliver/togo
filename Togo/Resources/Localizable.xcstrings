      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abonnement se renouvelle tout seul tant qu'il n'est pas annulé, au plus tard 24 heures avant la fin de la période. Le paiement est débité sur ton compte Apple à la confirmation de l'achat. Tu peux l'annuler dans les réglages de l'App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
