      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entrées sur le chien — sorties, repas, eau, selles, incidents, séances, poids, traitements — sont stockées dans la base sur l'appareil et dans l'espace partagé de l'app et de ses widgets."
          }
