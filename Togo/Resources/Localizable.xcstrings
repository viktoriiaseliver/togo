    "%@ · %@. Запись в ленте останется — её убирают там же, где и любую другую." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. L'entrée dans le fil restera — elle se retire là où n'importe quelle autre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. Запись в ленте останется — её убирают там же, где и любую другую."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ · %@. Запис у стрічці залишиться — його прибирають там само, де й будь-який інший."
          }
        }
      }
    },
    "%@ · %@. Из графика и из коридора веса запись тоже уйдёт." : {
      "comment" : "history",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. L'entrée disparaîtra aussi du graphique et de la plage de poids."
          }
        },
        "ru" : {
