        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай виходите частіше · %@ з %@ за день"
          }
        }
      }
    },
    "Обычно около %@. На прогулках сейчас внимательнее: кобели чувствуют за километр, и это не про воспитание." : {
      "comment" : "ongoingCard",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En général autour de %@. Redouble d'attention en promenade : les mâles la sentent à un kilomètre, et ça n'a rien à voir avec l'éducation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно около %@. На прогулках сейчас внимательнее: кобели чувствуют за километр, и это не про воспитание."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай близько %@. На прогулянках зараз уважніше: кобелі чують за кілометр, і це не про виховання."
          }
        }
      }
    },
    "обычно так" : {
      "comment" : "option",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le plus courant"
