    "Дежурный получает напоминания, и только он. Передача дежурства — одно действие." : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celui qui est de garde reçoit les rappels, et lui seul. Passer la garde tient en une action."
          }
        },
        "ru" : {
