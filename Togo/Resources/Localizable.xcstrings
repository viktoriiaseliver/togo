      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application aide à tenir un journal et n'est pas un dispositif médical. Elle ne pose pas de diagnostic et ne prescrit pas de dosage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение помогает вести записи и не является медицинским устройством. Диагнозов не ставит, дозировок не назначает."
          }
        },
        "uk" : {
          "stringUnit" : {
