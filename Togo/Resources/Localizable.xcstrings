        }
      }
    },
    "если ничего не отмечено — запись уже сохранена" : {
      "comment" : "body",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "si rien n'est coché, l'entrée est déjà enregistrée"
