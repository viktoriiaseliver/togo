{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Того · дизайн-токены. Единственный источник правды для Figma, iOS и веб-макета. Три уровня, ровно как коллекции переменных в Figma: Primitive → Semantic → Component. Прикладной код читает только Semantic и Component, никогда Primitive.",
  "primitive": {
    "$description": "Сырые значения. В Figma — коллекция Primitive, скрытая от дизайнеров экранов.",
    "color": {
      "$type": "color",
      "stone": {
        "$value": "#F1F0EB",
        "$description": "Холодный камень — фон экрана"
      },
      "white": {
        "$value": "#FFFFFF",
        "$description": "Карточки"
      },
      "stoneSunken": {
        "$value": "#E8E7E1",
        "$description": "Утопленная поверхность и вторая кнопка"
      },
      "stoneLine": {
        "$value": "#DFDED7",
        "$description": "Волосяная линия"
      },
      "inkDeep": {
        "$value": "#191C19",
        "$description": "Чернильный — текст и тосты"
      },
      "inkMuted": {
        "$value": "#5E625E",
        "$description": "Второстепенный текст"
      },
      "inkFaint": {
        "$value": "#7F8480",
        "$description": "Подписи и мета"
      },
      "sage": {
        "$value": "#3F6B50",
        "$description": "Шалфей — заливка"
      },
      "sageText": {
        "$value": "#2E5741",
        "$description": "Шалфей — текст, 7,4:1 на камне"
      },
      "sageTint": {
        "$value": "#DEE8E0",
        "$description": "Шалфей — тинт"
      },
      "sageMuted": {
        "$value": "#6E7F72",
        "$description": "Силуэты и декоративные иконки"
      },
      "brick": {
        "$value": "#B4482A",
        "$description": "Кирпич — заливка, белый на нём 5,4:1"
      },
      "brickText": {
        "$value": "#9C3D22",
        "$description": "Кирпич — текст, 5,9:1 на камне"
      },
      "brickTint": {
        "$value": "#F6E3DB",
        "$description": "Кирпич — тинт"
      },
      "mustard": {
        "$value": "#8A5F12",
        "$description": "Горчица — текст, 4,6:1 на тинте"
      },
      "mustardTint": {
        "$value": "#F2E7CB",
        "$description": "Горчица — тинт"
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": "0px"
      },
      "2": {
        "$value": "2px"
      },
      "4": {
        "$value": "4px"
      },
      "6": {
        "$value": "6px"
      },
      "8": {
        "$value": "8px"
      },
      "10": {
        "$value": "10px"
      },
      "12": {
        "$value": "12px"
      },
      "14": {
        "$value": "14px"
      },
      "16": {
        "$value": "16px"
      },
      "20": {
        "$value": "20px"
      },
      "24": {
        "$value": "24px"
      },
      "28": {
        "$value": "28px"
      },
      "32": {
        "$value": "32px"
      },
      "44": {
        "$value": "44px"
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": "0px"
      },
      "sm": {
        "$value": "8px"
      },
      "md": {
        "$value": "14px"
      },
      "lg": {
        "$value": "18px"
      },
      "xl": {
        "$value": "20px"
      },
      "pill": {
        "$value": "999px"
      }
    },
    "size": {
      "$type": "dimension",
      "hairline": {
        "$value": "1px"
      },
      "handleW": {
        "$value": "36px"
      },
      "handleH": {
        "$value": "4px"
      },
      "tapTarget": {
        "$value": "44px"
      },
      "controlM": {
        "$value": "50px"
      },
      "controlL": {
        "$value": "52px"
      },
      "controlXL": {
        "$value": "54px"
      },
      "avatarSm": {
        "$value": "26px"
      },
      "avatarMd": {
        "$value": "40px"
      },
      "iconSm": {
        "$value": "13px"
      },
      "iconMd": {
        "$value": "16px"
      },
      "iconLg": {
        "$value": "20px"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "ui": {
          "$value": "SF Pro",
          "$description": "Системный шрифт: единственный, который уже загружен и умеет Dynamic Type."
        }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semibold": {
          "$value": 600
        },
        "bold": {
          "$value": 700
        }
      },
      "size": {
        "$type": "dimension",
        "micro": {
          "$value": "12px"
        },
        "caption": {
          "$value": "14px"
        },
        "body": {
          "$value": "16px"
        },
        "title": {
          "$value": "17px"
        },
        "section": {
          "$value": "20px"
        },
        "screen": {
          "$value": "28px"
        },
        "display": {
          "$value": "34px"
        },
        "hero": {
          "$value": "44px"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "120ms"
      },
      "quick": {
        "$value": "180ms"
      },
      "settle": {
        "$value": "280ms"
      }
    },
    "elevation": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#221E18",
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "10px",
          "spread": "0px",
          "alpha": 0.05
        }
      },
      "float": {
        "$value": {
          "color": "#221E18",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px",
          "alpha": 0.12
        }
      }
    }
  },
  "semantic": {
    "$description": "Роли. В Figma — коллекция Semantic; именно её видит дизайнер, собирая экран.",
    "surface": {
      "$type": "color",
      "screen": {
        "$value": "{primitive.color.stone}"
      },
      "card": {
        "$value": "{primitive.color.white}"
      },
      "sunken": {
        "$value": "{primitive.color.stoneSunken}"
      },
      "hairline": {
        "$value": "{primitive.color.stoneLine}"
      }
    },
    "text": {
      "$type": "color",
      "primary": {
        "$value": "{primitive.color.inkDeep}"
      },
      "secondary": {
        "$value": "{primitive.color.inkMuted}"
      },
      "faint": {
        "$value": "{primitive.color.inkFaint}"
      },
      "onAccent": {
        "$value": "{primitive.color.white}",
        "$description": "Белый на кирпиче и на шалфее"
      },
      "silhouette": {
        "$value": "{primitive.color.sageMuted}",
        "$description": "Коричневого в приложении про стул больше нет"
      }
    },
    "action": {
      "$type": "color",
      "primary": {
        "$value": "{primitive.color.brick}",
        "$description": "Одно главное действие на экран"
      },
      "primaryQuiet": {
        "$value": "{primitive.color.brickTint}"
      },
      "secondary": {
        "$value": "{primitive.color.stoneSunken}"
      },
      "done": {
        "$value": "{primitive.color.sage}",
        "$description": "Норма, навигация, «сделано»"
      },
      "doneQuiet": {
        "$value": "{primitive.color.sageTint}"
      }
    },
    "status": {
      "$type": "color",
      "waitingBg": {
        "$value": "{primitive.color.mustardTint}",
        "$description": "Только окно натощак"
      },
      "waitingText": {
        "$value": "{primitive.color.mustard}"
      },
      "overdueBg": {
        "$value": "{primitive.color.brickTint}"
      },
      "overdueText": {
        "$value": "{primitive.color.brickText}"
      },
      "doneBg": {
        "$value": "{primitive.color.sageTint}"
      },
      "doneText": {
        "$value": "{primitive.color.sageText}"
      }
    },
    "spacing": {
      "$type": "dimension",
      "screenPadding": {
        "$value": "{primitive.space.20}"
      },
      "stack": {
        "$value": "{primitive.space.14}"
      },
      "cardPadding": {
        "$value": "{primitive.space.16}"
      },
      "rowGap": {
        "$value": "{primitive.space.12}"
      },
      "tight": {
        "$value": "{primitive.space.8}"
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{primitive.radius.lg}"
      },
      "tile": {
        "$value": "{primitive.radius.md}"
      },
      "control": {
        "$value": "{primitive.radius.md}"
      },
      "sheet": {
        "$value": "{primitive.radius.xl}"
      },
      "small": {
        "$value": "{primitive.radius.sm}",
        "$description": "Мелкие подложки: ячейка календаря, счётчик, бейдж."
      }
    }
  },
  "component": {
    "$description": "Слой компонентов: то, что в Figma лежит свойствами внутри самого компонента. Прикладной экран сюда не лезет — он ставит вариант.",
    "button": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.primary}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.onAccent}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlL}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.secondary}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.primary}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "destructive": {
        "background": {
          "$type": "color",
          "$value": "{semantic.status.overdueBg}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.status.overdueText}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "disabled": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.secondary}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.faint}"
        }
      },
      "finish": {
        "background": {
          "$type": "color",
          "$value": "{semantic.status.doneBg}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.status.doneText}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      }
    },
    "chip": {
      "restBackground": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "selectedBackground": {
        "$type": "color",
        "$value": "{semantic.action.primaryQuiet}"
      },
      "alarmBackground": {
        "$type": "color",
        "$value": "{semantic.status.overdueBg}"
      },
      "alarmLabel": {
        "$type": "color",
        "$value": "{semantic.status.overdueText}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{primitive.size.tapTarget}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.tile}"
      }
    },
    "card": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{semantic.spacing.cardPadding}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      }
    },
    "sheet": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.screen}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.sheet}"
      },
      "handleWidth": {
        "$type": "dimension",
        "$value": "{primitive.size.handleW}"
      },
      "handleHeight": {
        "$type": "dimension",
        "$value": "{primitive.size.handleH}"
      },
      "handleColor": {
        "$type": "color",
        "$value": "{semantic.surface.hairline}"
      }
    },
    "banner": {
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{primitive.space.14}"
      },
      "titleSize": {
        "$type": "dimension",
        "$value": "{primitive.font.size.section}",
        "$description": "28px в макете было мелко — плашку натощак можно было проскроллить."
      }
    },
    "timeline": {
      "nowMarker": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "syncedMark": {
        "$type": "color",
        "$value": "{semantic.action.done}"
      },
      "alarmMark": {
        "$type": "color",
        "$value": "{semantic.status.overdueText}"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "{primitive.space.12}"
      }
    },
    "actionTile": {
      "background": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.tile}"
      },
      "minHeight": {
        "$type": "dimension",
        "$value": "{primitive.size.controlL}"
      }
    }
  }
}
