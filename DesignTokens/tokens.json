{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Того · дизайн-токены. Единственный источник правды для Figma, iOS и веб-макета. Три уровня, ровно как коллекции переменных в Figma: Primitive → Semantic → Component. Прикладной код читает только Semantic и Component, никогда Primitive.",
  "primitive": {
    "$description": "Сырые значения. В Figma — коллекция Primitive, скрытая от дизайнеров экранов.",
    "color": {
      "$type": "color",
      "night1": {
        "$value": "#0B1016",
        "$description": "Фон экрана"
      },
      "night2": {
        "$value": "#151C24",
        "$description": "Карточка"
      },
      "night3": {
        "$value": "#222B36",
        "$description": "Приподнятая поверхность"
      },
      "night4": {
        "$value": "#2D3844",
        "$description": "Контрол"
      },
      "night5": {
        "$value": "#384552",
        "$description": "Нажатое и скелетон. Своего значения в «Льду» нет: продолжение ночной рампы тем же шагом, +11 +13 +14"
      },
      "ink": {
        "$value": "#F2F5F8",
        "$description": "Основной текст. 17,45:1 на экране, 15,69:1 на карточке"
      },
      "inkMuted": {
        "$value": "#9AA7B4",
        "$description": "Вторичный текст. 7,0:1 на карточке. Непрозрачный намеренно: альфа съедает запас контраста"
      },
      "inkFaint": {
        "$value": "#6F7C89",
        "$description": "Только неактивное. 4,02:1 на карточке — ниже 4,5, поэтому текстом и значками НЕ красится ни в каком кегле. Разрешение «только с 14pt» было неверным и развело его по двадцати четырём файлам"
      },
      "arctic": {
        "$value": "#7FB2FF",
        "$description": "Интерактив и «сейчас» — и только они. 8,83:1 на экране, 7,94:1 на карточке"
      },
      "arcticPressed": {
        "$value": "#A8CCFF",
        "$description": "Нажатый интерактив: действие светлеет, без сжатия"
      },
      "arcticTint": {
        "$value": "#7FB2FF26",
        "$description": "Интерактив — плашка. Над карточкой даёт #253245"
      },
      "arcticInk": {
        "$value": "#06142A",
        "$description": "Текст на синей заливке, 8,51:1. Белый на этом синем не проходит 4,5:1 — потому подпись тёмная"
      },
      "spruce": {
        "$value": "#5FBF93",
        "$description": "«Сделано»: заливка и галочка. 7,65:1 на карточке"
      },
      "spruceText": {
        "$value": "#7FD3A8",
        "$description": "«Сделано» словами. 9,63:1 на карточке"
      },
      "spruceTint": {
        "$value": "#5FBF9326",
        "$description": "«Сделано» — плашка. Над карточкой даёт #203435"
      },
      "amber": {
        "$value": "#FFD60A",
        "$description": "«Ждём»: окно натощак, пауза. 9,14:1 на своей плашке"
      },
      "amberBg": {
        "$value": "#3A3112",
        "$description": "«Ждём» — плашка. Непрозрачная"
      },
      "clay": {
        "$value": "#FF6B5E",
        "$description": "Тревога: инцидент, срыв, просрочка. 5,46:1 на своей плашке"
      },
      "clayBg": {
        "$value": "#3E1B19",
        "$description": "Тревога — плашка. Непрозрачная"
      },
      "glass": {
        "$value": "#1B2430C7",
        "$description": "Стекло: таббар, круглые кнопки, пауза. Больше нигде"
      },
      "glassEdge": {
        "$value": "#FFFFFF1A",
        "$description": "Внутренний край стекла, 1px"
      },
      "scrim": {
        "$value": "#000000A6",
        "$description": "Затемнение под шторкой"
      },
      "hairline": {
        "$value": "#2D3844",
        "$description": "Линия только между строками списка"
      }
    },
    "space": {
      "$type": "dimension",
      "2": {
        "$value": "2px"
      },
      "4": {
        "$value": "4px"
      },
      "6": {
        "$value": "6px"
      },
      "8": {
        "$value": "8px"
      },
      "10": {
        "$value": "10px"
      },
      "12": {
        "$value": "12px"
      },
      "14": {
        "$value": "14px"
      },
      "16": {
        "$value": "16px"
      },
      "20": {
        "$value": "20px"
      },
      "24": {
        "$value": "24px"
      },
      "28": {
        "$value": "28px"
      },
      "32": {
        "$value": "32px"
      },
      "18": {
        "$value": "18px"
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": "0px"
      },
      "md": {
        "$value": "14px"
      },
      "card": {
        "$value": "20px"
      },
      "row": {
        "$value": "16px"
      },
      "capsule": {
        "$value": "30px",
        "$description": "Половина капсулы 60 pt. Капсула — только у главного действия"
      },
      "icon": {
        "$value": "12px"
      },
      "tile": {
        "$value": "18px"
      },
      "sheet": {
        "$value": "40px"
      }
    },
    "size": {
      "$type": "dimension",
      "hairline": {
        "$value": "1px"
      },
      "handleW": {
        "$value": "36px"
      },
      "handleH": {
        "$value": "4px"
      },
      "tapTarget": {
        "$value": "44px"
      },
      "controlM": {
        "$value": "50px"
      },
      "controlL": {
        "$value": "52px",
        "$description": "Плитка действия. Было общим с главной кнопкой: один номер держал две роли, и «капсула 60 pt» из «Льда» растила заодно плитки"
      },
      "capsule": {
        "$value": "60px",
        "$description": "Главное действие — капсула 60 pt. Только оно"
      },
      "controlXL": {
        "$value": "54px"
      },
      "avatarSm": {
        "$value": "26px"
      },
      "avatarMd": {
        "$value": "40px"
      },
      "iconSm": {
        "$value": "13px"
      },
      "iconMd": {
        "$value": "16px"
      },
      "iconLg": {
        "$value": "20px"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "ui": {
          "$value": "SF Pro",
          "$description": "Системный шрифт: единственный, который уже загружен и умеет Dynamic Type."
        },
        "display": {
          "$value": "SF Pro Rounded",
          "$description": "Главная цифра, кличка, заголовок экрана. Остальное — SF Pro"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semibold": {
          "$value": 600
        },
        "bold": {
          "$value": 700
        },
        "heavy": {
          "$value": 800,
          "$description": "Только SF Pro Rounded в главной цифре, кличке и заголовке экрана"
        }
      },
      "size": {
        "$type": "dimension",
        "caption": {
          "$value": "14px",
          "$description": "Капс: название секции, 600"
        },
        "meta": {
          "$value": "15px",
          "$description": "Мета: время, автор, подпись"
        },
        "body": {
          "$value": "17px",
          "$description": "Строка списка"
        },
        "section": {
          "$value": "20px",
          "$description": "Заголовок карточки"
        },
        "screen": {
          "$value": "34px",
          "$description": "Название экрана"
        },
        "display": {
          "$value": "34px",
          "$description": "Крупная цифра карточки"
        },
        "hero": {
          "$value": "56px",
          "$description": "Ответ на главный вопрос — один на экран"
        },
        "micro": {
          "$value": "14px",
          "$description": "Было 12. Ниже четырнадцати в системе не существует"
        },
        "title": {
          "$value": "17px"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "120ms"
      },
      "quick": {
        "$value": "180ms"
      },
      "settle": {
        "$value": "280ms"
      }
    },
    "elevation": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "10px",
          "spread": "0px",
          "alpha": 0.05
        }
      },
      "float": {
        "$value": {
          "color": "#000000",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px",
          "alpha": 0.12
        }
      }
    }
  },
  "semantic": {
    "$description": "Роли. В Figma — коллекция Semantic; именно её видит дизайнер, собирая экран.",
    "surface": {
      "$type": "color",
      "screen": {
        "$value": "{primitive.color.night1}"
      },
      "card": {
        "$value": "{primitive.color.night2}"
      },
      "sunken": {
        "$value": "{primitive.color.night3}"
      },
      "hairline": {
        "$value": "{primitive.color.hairline}"
      },
      "control": {
        "$value": "{primitive.color.night4}"
      },
      "pressed": {
        "$value": "{primitive.color.night5}"
      },
      "glass": {
        "$value": "{primitive.color.glass}",
        "$description": "Стекло таббара и круглых кнопок"
      },
      "glassEdge": {
        "$value": "{primitive.color.glassEdge}",
        "$description": "Внутренний край стекла"
      },
      "scrim": {
        "$value": "{primitive.color.scrim}",
        "$description": "Затемнение под шторкой"
      }
    },
    "text": {
      "$type": "color",
      "primary": {
        "$value": "{primitive.color.ink}"
      },
      "secondary": {
        "$value": "{primitive.color.inkMuted}"
      },
      "faint": {
        "$value": "{primitive.color.inkFaint}"
      },
      "onAccent": {
        "$value": "{primitive.color.arcticInk}"
      },
      "silhouette": {
        "$value": "{primitive.color.inkMuted}"
      }
    },
    "action": {
      "$type": "color",
      "primary": {
        "$value": "{primitive.color.arctic}"
      },
      "primaryQuiet": {
        "$value": "{primitive.color.arcticTint}"
      },
      "secondary": {
        "$value": "{primitive.color.night4}"
      },
      "done": {
        "$value": "{primitive.color.spruceTint}"
      },
      "doneText": {
        "$value": "{primitive.color.spruceText}",
        "$description": "«Сделано» СЛОВАМИ. Отдельный токен, потому что done — это тинт 15 %: как чернила он даёт 1,31:1 на карточке, вдвое хуже уже запрещённого faint. Та же пара, что waitingText и overdueText."
      },
      "doneQuiet": {
        "$value": "{primitive.color.spruceTint}"
      },
      "primaryPressed": {
        "$value": "{primitive.color.arcticPressed}",
        "$description": "Нажатое главное действие"
      }
    },
    "status": {
      "$type": "color",
      "waitingBg": {
        "$value": "{primitive.color.amberBg}"
      },
      "waitingText": {
        "$value": "{primitive.color.amber}"
      },
      "overdueBg": {
        "$value": "{primitive.color.clayBg}"
      },
      "overdueText": {
        "$value": "{primitive.color.clay}"
      },
      "doneBg": {
        "$value": "{primitive.color.spruceTint}"
      },
      "doneText": {
        "$value": "{primitive.color.ink}"
      }
    },
    "spacing": {
      "$type": "dimension",
      "screenPadding": {
        "$value": "{primitive.space.18}"
      },
      "stack": {
        "$value": "{primitive.space.12}"
      },
      "cardPadding": {
        "$value": "{primitive.space.16}"
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{primitive.radius.card}"
      },
      "tile": {
        "$value": "{primitive.radius.tile}"
      },
      "control": {
        "$value": "{primitive.radius.row}"
      },
      "sheet": {
        "$value": "{primitive.radius.sheet}"
      },
      "small": {
        "$value": "{primitive.radius.icon}"
      }
    }
  },
  "component": {
    "$description": "Слой компонентов: то, что в Figma лежит свойствами внутри самого компонента. Прикладной экран сюда не лезет — он ставит вариант.",
    "button": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.primary}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.onAccent}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.capsule}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{primitive.radius.capsule}"
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{semantic.surface.control}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.primary}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "destructive": {
        "background": {
          "$type": "color",
          "$value": "{semantic.status.overdueBg}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.status.overdueText}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "disabled": {
        "background": {
          "$type": "color",
          "$value": "{semantic.surface.control}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.faint}"
        }
      },
      "finish": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.primaryQuiet}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.status.doneText}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      }
    },
    "chip": {
      "restBackground": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "selectedBackground": {
        "$type": "color",
        "$value": "{semantic.action.primaryQuiet}"
      },
      "alarmBackground": {
        "$type": "color",
        "$value": "{semantic.status.overdueBg}"
      },
      "alarmLabel": {
        "$type": "color",
        "$value": "{semantic.status.overdueText}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{primitive.size.tapTarget}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.tile}"
      }
    },
    "card": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{semantic.spacing.cardPadding}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      }
    },
    "sheet": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.screen}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.sheet}"
      },
      "handleWidth": {
        "$type": "dimension",
        "$value": "{primitive.size.handleW}"
      },
      "handleHeight": {
        "$type": "dimension",
        "$value": "{primitive.size.handleH}"
      },
      "handleColor": {
        "$type": "color",
        "$value": "{semantic.surface.hairline}"
      }
    },
    "banner": {
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{primitive.space.14}"
      },
      "titleSize": {
        "$type": "dimension",
        "$value": "{primitive.font.size.section}",
        "$description": "28px в макете было мелко — плашку натощак можно было проскроллить."
      }
    },
    "timeline": {
      "nowMarker": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "syncedMark": {
        "$type": "color",
        "$value": "{semantic.action.done}"
      },
      "alarmMark": {
        "$type": "color",
        "$value": "{semantic.status.overdueText}"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "{primitive.space.12}"
      }
    },
    "actionTile": {
      "background": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.tile}"
      },
      "minHeight": {
        "$type": "dimension",
        "$value": "{primitive.size.controlL}"
      }
    }
  }
}
