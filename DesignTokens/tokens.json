{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Того · дизайн-токены. Единственный источник правды для Figma, iOS и веб-макета. Три уровня, ровно как коллекции переменных в Figma: Primitive → Semantic → Component. Прикладной код читает только Semantic и Component, никогда Primitive.",
  "primitive": {
    "$description": "Сырые значения. В Figma — коллекция Primitive, скрытая от дизайнеров экранов.",
    "color": {
      "$type": "color",
      "s0": {
        "$value": "#000000",
        "$description": "Экран"
      },
      "s1": {
        "$value": "#101013",
        "$description": "Карточка"
      },
      "s2": {
        "$value": "#17171B",
        "$description": "Вложенная поверхность"
      },
      "s3": {
        "$value": "#202026",
        "$description": "Контрол и бокс под иконку"
      },
      "s4": {
        "$value": "#2A2A31",
        "$description": "Нажатое состояние"
      },
      "hairline": {
        "$value": "#FFFFFF12",
        "$description": "Линия только между строками внутри группы, 7%"
      },
      "highlight": {
        "$value": "#FFFFFF0F",
        "$description": "Внутренний хайлайт сверху, 6%"
      },
      "white": {
        "$value": "#FFFFFF",
        "$description": "Текст факта"
      },
      "whiteMuted": {
        "$value": "#EBEBF599",
        "$description": "Вторичный текст, 60%"
      },
      "whiteFaint": {
        "$value": "#EBEBF54D",
        "$description": "Мета и выключенное, 30%"
      },
      "mint": {
        "$value": "#22D3B0",
        "$description": "Мята — заливка. Действие, «сделано» и норма разом"
      },
      "mintText": {
        "$value": "#4FEBCE",
        "$description": "Мята — текст и иконки на тёмном"
      },
      "mintInk": {
        "$value": "#00201A",
        "$description": "Текст на мятной заливке"
      },
      "mintTint": {
        "$value": "#22D3B024",
        "$description": "Мята — тинт 14%"
      },
      "amber": {
        "$value": "#FFCC33",
        "$description": "Жёлтый — подожди, окно натощак"
      },
      "amberTint": {
        "$value": "#FFCC3324",
        "$description": "Жёлтый — тинт 14%"
      },
      "red": {
        "$value": "#FF453A",
        "$description": "Красный — инцидент, срыв, просрочка"
      },
      "redTint": {
        "$value": "#FF453A24",
        "$description": "Красный — тинт 14%"
      }
    },
    "space": {
      "$type": "dimension",
      "0": {
        "$value": "0px"
      },
      "2": {
        "$value": "2px"
      },
      "4": {
        "$value": "4px"
      },
      "6": {
        "$value": "6px"
      },
      "8": {
        "$value": "8px"
      },
      "10": {
        "$value": "10px"
      },
      "12": {
        "$value": "12px"
      },
      "14": {
        "$value": "14px"
      },
      "16": {
        "$value": "16px"
      },
      "20": {
        "$value": "20px"
      },
      "24": {
        "$value": "24px"
      },
      "28": {
        "$value": "28px"
      },
      "32": {
        "$value": "32px"
      },
      "44": {
        "$value": "44px"
      }
    },
    "radius": {
      "$type": "dimension",
      "none": {
        "$value": "0px"
      },
      "sm": {
        "$value": "8px"
      },
      "md": {
        "$value": "14px"
      },
      "lg": {
        "$value": "18px"
      },
      "xl": {
        "$value": "20px"
      },
      "pill": {
        "$value": "999px"
      },
      "card": {
        "$value": "26px"
      },
      "row": {
        "$value": "18px"
      },
      "icon": {
        "$value": "12px"
      }
    },
    "size": {
      "$type": "dimension",
      "hairline": {
        "$value": "1px"
      },
      "handleW": {
        "$value": "36px"
      },
      "handleH": {
        "$value": "4px"
      },
      "tapTarget": {
        "$value": "44px"
      },
      "controlM": {
        "$value": "50px"
      },
      "controlL": {
        "$value": "52px"
      },
      "controlXL": {
        "$value": "54px"
      },
      "avatarSm": {
        "$value": "26px"
      },
      "avatarMd": {
        "$value": "40px"
      },
      "iconSm": {
        "$value": "13px"
      },
      "iconMd": {
        "$value": "16px"
      },
      "iconLg": {
        "$value": "20px"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "ui": {
          "$value": "SF Pro",
          "$description": "Системный шрифт: единственный, который уже загружен и умеет Dynamic Type."
        }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": {
          "$value": 400
        },
        "medium": {
          "$value": 500
        },
        "semibold": {
          "$value": 600
        },
        "bold": {
          "$value": 700
        }
      },
      "size": {
        "$type": "dimension",
        "caption": {
          "$value": "14px",
          "$description": "Капс: название секции, 600"
        },
        "meta": {
          "$value": "15px",
          "$description": "Мета: время, автор, подпись"
        },
        "body": {
          "$value": "17px",
          "$description": "Строка списка"
        },
        "section": {
          "$value": "20px",
          "$description": "Заголовок карточки"
        },
        "screen": {
          "$value": "34px",
          "$description": "Название экрана"
        },
        "display": {
          "$value": "34px",
          "$description": "Крупная цифра карточки"
        },
        "hero": {
          "$value": "56px",
          "$description": "Ответ на главный вопрос — один на экран"
        },
        "micro": {
          "$value": "14px",
          "$description": "Было 12. Ниже четырнадцати в системе не существует"
        },
        "title": {
          "$value": "17px"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "120ms"
      },
      "quick": {
        "$value": "180ms"
      },
      "settle": {
        "$value": "280ms"
      }
    },
    "elevation": {
      "$type": "shadow",
      "card": {
        "$value": {
          "color": "#221E18",
          "offsetX": "0px",
          "offsetY": "3px",
          "blur": "10px",
          "spread": "0px",
          "alpha": 0.05
        }
      },
      "float": {
        "$value": {
          "color": "#221E18",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "14px",
          "spread": "0px",
          "alpha": 0.12
        }
      }
    }
  },
  "semantic": {
    "$description": "Роли. В Figma — коллекция Semantic; именно её видит дизайнер, собирая экран.",
    "surface": {
      "$type": "color",
      "screen": {
        "$value": "{primitive.color.s0}"
      },
      "card": {
        "$value": "{primitive.color.s1}"
      },
      "sunken": {
        "$value": "{primitive.color.s2}"
      },
      "hairline": {
        "$value": "{primitive.color.hairline}"
      },
      "control": {
        "$value": "{primitive.color.s3}"
      },
      "pressed": {
        "$value": "{primitive.color.s4}"
      }
    },
    "text": {
      "$type": "color",
      "primary": {
        "$value": "{primitive.color.white}"
      },
      "secondary": {
        "$value": "{primitive.color.whiteMuted}"
      },
      "faint": {
        "$value": "{primitive.color.whiteFaint}"
      },
      "onAccent": {
        "$value": "{primitive.color.mintInk}"
      },
      "silhouette": {
        "$value": "{primitive.color.whiteFaint}"
      }
    },
    "action": {
      "$type": "color",
      "primary": {
        "$value": "{primitive.color.mint}"
      },
      "primaryQuiet": {
        "$value": "{primitive.color.mintTint}"
      },
      "secondary": {
        "$value": "{primitive.color.s3}"
      },
      "done": {
        "$value": "{primitive.color.mint}"
      },
      "doneQuiet": {
        "$value": "{primitive.color.mintTint}"
      }
    },
    "status": {
      "$type": "color",
      "waitingBg": {
        "$value": "{primitive.color.amberTint}"
      },
      "waitingText": {
        "$value": "{primitive.color.amber}"
      },
      "overdueBg": {
        "$value": "{primitive.color.redTint}"
      },
      "overdueText": {
        "$value": "{primitive.color.red}"
      },
      "doneBg": {
        "$value": "{primitive.color.mintTint}"
      },
      "doneText": {
        "$value": "{primitive.color.mintText}"
      }
    },
    "spacing": {
      "$type": "dimension",
      "screenPadding": {
        "$value": "{primitive.space.14}"
      },
      "stack": {
        "$value": "{primitive.space.14}"
      },
      "cardPadding": {
        "$value": "{primitive.space.20}"
      },
      "rowGap": {
        "$value": "{primitive.space.12}"
      },
      "tight": {
        "$value": "{primitive.space.8}"
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{primitive.radius.card}"
      },
      "tile": {
        "$value": "{primitive.radius.row}"
      },
      "control": {
        "$value": "{primitive.radius.row}"
      },
      "sheet": {
        "$value": "{primitive.radius.card}"
      },
      "small": {
        "$value": "{primitive.radius.icon}"
      },
      "pill": {
        "$value": "{primitive.radius.pill}"
      }
    }
  },
  "component": {
    "$description": "Слой компонентов: то, что в Figma лежит свойствами внутри самого компонента. Прикладной экран сюда не лезет — он ставит вариант.",
    "button": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.primary}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.onAccent}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlL}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{semantic.surface.control}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.primary}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "destructive": {
        "background": {
          "$type": "color",
          "$value": "{semantic.status.overdueBg}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.status.overdueText}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      },
      "disabled": {
        "background": {
          "$type": "color",
          "$value": "{semantic.surface.control}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.text.faint}"
        }
      },
      "finish": {
        "background": {
          "$type": "color",
          "$value": "{semantic.action.primaryQuiet}"
        },
        "label": {
          "$type": "color",
          "$value": "{semantic.status.doneText}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{primitive.size.controlM}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{semantic.radius.control}"
        }
      }
    },
    "chip": {
      "restBackground": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "selectedBackground": {
        "$type": "color",
        "$value": "{semantic.action.primaryQuiet}"
      },
      "alarmBackground": {
        "$type": "color",
        "$value": "{semantic.status.overdueBg}"
      },
      "alarmLabel": {
        "$type": "color",
        "$value": "{semantic.status.overdueText}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{primitive.size.tapTarget}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.tile}"
      }
    },
    "card": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{semantic.spacing.cardPadding}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      }
    },
    "sheet": {
      "background": {
        "$type": "color",
        "$value": "{semantic.surface.screen}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.sheet}"
      },
      "handleWidth": {
        "$type": "dimension",
        "$value": "{primitive.size.handleW}"
      },
      "handleHeight": {
        "$type": "dimension",
        "$value": "{primitive.size.handleH}"
      },
      "handleColor": {
        "$type": "color",
        "$value": "{semantic.surface.hairline}"
      }
    },
    "banner": {
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{primitive.space.14}"
      },
      "titleSize": {
        "$type": "dimension",
        "$value": "{primitive.font.size.section}",
        "$description": "28px в макете было мелко — плашку натощак можно было проскроллить."
      }
    },
    "timeline": {
      "nowMarker": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "syncedMark": {
        "$type": "color",
        "$value": "{semantic.action.done}"
      },
      "alarmMark": {
        "$type": "color",
        "$value": "{semantic.status.overdueText}"
      },
      "gutter": {
        "$type": "dimension",
        "$value": "{primitive.space.12}"
      }
    },
    "actionTile": {
      "background": {
        "$type": "color",
        "$value": "{semantic.action.secondary}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.tile}"
      },
      "minHeight": {
        "$type": "dimension",
        "$value": "{primitive.size.controlL}"
      }
    }
  }
}
